# Public MapTiler configuration for map tiles.
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Optional public contribution links. Leave empty until public channels exist.
DOENER_PRICE_FORM_URL=
DOENER_CORRECTION_EMAIL=
DOENER_CORRECTION_URL=

# Optional local development LAN origins, comma-separated.
# Example: NEXT_ALLOWED_DEV_ORIGINS=192.168.178.113
NEXT_ALLOWED_DEV_ORIGINS=

# Public legal/imprint placeholders. Fill before public deployment.
DOENER_LEGAL_OPERATOR_NAME=
DOENER_LEGAL_OPERATOR_ADDRESS=
DOENER_LEGAL_CONTACT_EMAIL=
